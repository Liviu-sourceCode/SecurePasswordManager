pipeline {
  agent {
    label '!windows'
  }

  options {
    timestamps()
    disableConcurrentBuilds()
  }

  stages {
    stage('Checkout') {
      steps {
        checkout scm
        sh 'date +%s > .build-start-epoch'
      }
    }

    stage('Release Guard (v* tags only)') {
      steps {
        script {
          if (!(env.TAG_NAME ==~ /^v.*/)) {
            currentBuild.description = 'Skipped: not a v* tag build'
            error('This release pipeline runs only for tags named v* (enable tag discovery in multibranch).')
          }
        }
      }
    }

    stage('Preflight (Linux deps)') {
      steps {
        sh '''#!/usr/bin/env bash
set -euo pipefail

missing_tools=()
for cmd in curl pkg-config gcc make patchelf; do
  command -v "$cmd" >/dev/null 2>&1 || missing_tools+=("$cmd")
done

missing_libs=()
if ! pkg-config --exists gtk+-3.0; then
  missing_libs+=("gtk+-3.0")
fi

if ! pkg-config --exists webkit2gtk-4.1 && ! pkg-config --exists webkit2gtk-4.0; then
  missing_libs+=("webkit2gtk (4.1 or 4.0)")
fi

if ! pkg-config --exists libsoup-3.0 && ! pkg-config --exists libsoup-2.4; then
  missing_libs+=("libsoup (3.0 or 2.4)")
fi

if ! pkg-config --exists openssl; then
  missing_libs+=("openssl")
fi

if ! pkg-config --exists xdo && ! test -f /usr/lib64/libxdo.so && ! test -f /usr/lib/libxdo.so; then
  missing_libs+=("libxdo (install libxdo-devel)")
fi

if [[ ${#missing_tools[@]} -gt 0 || ${#missing_libs[@]} -gt 0 ]]; then
  echo "Missing required dependencies."
  [[ ${#missing_tools[@]} -gt 0 ]] && echo "Missing tools: ${missing_tools[*]}"
  [[ ${#missing_libs[@]} -gt 0 ]] && echo "Missing libs: ${missing_libs[*]}"
  echo
  echo "Install on Fedora:"
  echo "sudo dnf install -y curl pkgconf-pkg-config gcc gcc-c++ make patchelf webkit2gtk4.1-devel gtk3-devel libsoup3-devel openssl-devel libappindicator-gtk3-devel librsvg2-devel libxdo-devel"
  echo "Install on Debian/Ubuntu:"
  echo "sudo apt-get update && sudo apt-get install -y curl pkg-config build-essential patchelf libwebkit2gtk-4.1-dev libgtk-3-dev libsoup-3.0-dev libssl-dev libayatana-appindicator3-dev librsvg2-dev libxdo-dev"
  exit 1
fi
'''
      }
    }

    stage('Ensure Rust Toolchain') {
      steps {
        sh '''#!/usr/bin/env bash
set -euo pipefail

if ! command -v rustup >/dev/null 2>&1; then
  echo "Rustup not found, installing user-local toolchain..."
  RUSTUP_INIT_SKIP_PATH_CHECK=yes curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y
fi

export PATH="$HOME/.cargo/bin:$PATH"
source "$HOME/.cargo/env" 2>/dev/null || true
rustup toolchain install 1.96.0
rustup default 1.96.0
rustup component add rustfmt clippy
'''
      }
    }

    stage('Toolchain') {
      steps {
        sh 'node --version'
        sh 'npm --version'
        sh 'rustc --version'
        sh 'cargo --version'
      }
    }

    stage('Install Dependencies') {
      steps {
        sh 'npm ci'
      }
    }

    stage('Frontend Build') {
      steps {
        sh 'npm run build'
      }
    }

    stage('Rust Check') {
      steps {
        sh 'cargo check --manifest-path src-tauri/Cargo.toml --all-targets'
      }
    }

    stage('Native Host (Release)') {
      steps {
        sh 'cargo build --release --manifest-path src-tauri/Cargo.toml'
      }
    }

    stage('Linux AppImage Build') {
      steps {
        sh 'npm run tauri:build:linux'
      }
    }

    stage('Windows Build') {
      agent {
        node {
          label 'windows'
          customWorkspace 'C:/Jenkins/workspace/SecurePasswordManager-Release-Windows'
        }
      }
      steps {
        checkout scm
        bat '''@echo off
setlocal EnableExtensions EnableDelayedExpansion

      for /f "usebackq delims=" %%i in (`"%ProgramFiles(x86)%\\Microsoft Visual Studio\\Installer\\vswhere.exe" -latest -products * -requires Microsoft.VisualStudio.Component.VC.Tools.x86.x64 -property installationPath`) do set "VSINSTALL=%%i"

if not defined VSINSTALL (
  echo ERROR: Visual Studio C++ Build Tools not found.
  exit /b 1
)

call "%VSINSTALL%\\Common7\\Tools\\VsDevCmd.bat" -arch=x64 -host_arch=x64

set "CARGO_HOME=%USERPROFILE%\\.cargo"
set "RUSTUP_HOME=%USERPROFILE%\\.rustup"
set "PATH=%CARGO_HOME%\\bin;%PATH%"

where rustup
if errorlevel 1 (
  echo ERROR: rustup is required on windows10-vm but was not found on PATH.
  exit /b 1
)

call rustup toolchain install stable-x86_64-pc-windows-msvc
if errorlevel 1 (
  echo ERROR: Failed to install MSVC Rust toolchain.
  exit /b 1
)
call rustup default stable-x86_64-pc-windows-msvc
if errorlevel 1 (
  echo ERROR: Failed to set default MSVC Rust toolchain.
  exit /b 1
)

node -v
call npm -v
call rustup run stable-x86_64-pc-windows-msvc rustc -V
call rustup run stable-x86_64-pc-windows-msvc cargo -V
call rustup run stable-x86_64-pc-windows-msvc rustc -vV

call rustup target add x86_64-pc-windows-msvc
if errorlevel 1 (
  echo ERROR: Failed to install Rust target x86_64-pc-windows-msvc.
  exit /b 1
)
set "CARGO_BUILD_TARGET=x86_64-pc-windows-msvc"

if exist package-lock.json (
  echo Using npm ci ^(lockfile detected^)
  call npm ci
  if errorlevel 1 (
    echo ERROR: npm ci failed.
    exit /b 1
  )
) else (
  echo WARNING: package-lock.json not found, falling back to npm install
  call npm install
  if errorlevel 1 (
    echo ERROR: npm install failed.
    exit /b 1
  )
)

call npm run build
if errorlevel 1 (
  echo ERROR: frontend build failed.
  exit /b 1
)

taskkill /F /IM SecurePasswordManager.exe >nul 2>nul
if exist "src-tauri\\target\\x86_64-pc-windows-msvc\\release\\SecurePasswordManager.exe" del /F /Q "src-tauri\\target\\x86_64-pc-windows-msvc\\release\\SecurePasswordManager.exe" >nul 2>nul
if exist "src-tauri\\target\\release\\SecurePasswordManager.exe" del /F /Q "src-tauri\\target\\release\\SecurePasswordManager.exe" >nul 2>nul

call rustup run stable-x86_64-pc-windows-msvc cargo build --release --manifest-path src-tauri\\Cargo.toml --target x86_64-pc-windows-msvc --features custom-protocol
if errorlevel 1 (
  echo ERROR: Windows cargo build failed.
  exit /b 1
)

if not exist "src-tauri\\target\\x86_64-pc-windows-msvc\\release\\SecurePasswordManager.exe" if not exist "src-tauri\\target\\release\\SecurePasswordManager.exe" (
  echo ERROR: Windows executable output not found.
  if exist "src-tauri\\target\\x86_64-pc-windows-msvc\\release" dir /s /b "src-tauri\\target\\x86_64-pc-windows-msvc\\release"
  if exist "src-tauri\\target\\release" dir /s /b "src-tauri\\target\\release"
  exit /b 1
)

echo Windows release files:
if exist "src-tauri\\target\\x86_64-pc-windows-msvc\\release" dir /s /b "src-tauri\\target\\x86_64-pc-windows-msvc\\release"
if exist "src-tauri\\target\\release" dir /s /b "src-tauri\\target\\release"
'''

        stash name: 'windows-release-bundles', includes: 'src-tauri/target/x86_64-pc-windows-msvc/release/*.exe,src-tauri/target/x86_64-pc-windows-msvc/release/*.msi,src-tauri/target/x86_64-pc-windows-msvc/release/*.zip,src-tauri/target/release/*.exe,src-tauri/target/release/*.msi,src-tauri/target/release/*.zip', allowEmpty: false
      }
    }

    stage('Legal Bundle') {
      steps {
        sh 'npm run legal:bundle'
      }
    }

    stage('Collect Release Artifacts') {
      steps {
        sh '''#!/usr/bin/env bash
set -euo pipefail

mkdir -p release-artifacts

if [ -f src-tauri/target/release/SecurePasswordManager ]; then
  cp src-tauri/target/release/SecurePasswordManager release-artifacts/
fi

find src-tauri/target/release/bundle -type f '(' -name '*.AppImage' -o -name '*.deb' -o -name '*.rpm' ')' -exec cp {} release-artifacts/ ';' 2>/dev/null || true

if [ -d licenses ]; then
  cp -r licenses release-artifacts/
fi

if [ -f THIRD_PARTY_NOTICES.md ]; then
  cp THIRD_PARTY_NOTICES.md release-artifacts/
fi

if [ -f EULA.md ]; then
  cp EULA.md release-artifacts/
fi

if [ "$(find release-artifacts -type f | wc -l)" -eq 0 ]; then
  echo "No release artifacts produced."
  exit 1
fi

(
  cd release-artifacts
  find . -type f ! -name 'SHA256SUMS.txt' -print0 \
    | sort -z \
    | xargs -0 sha256sum > SHA256SUMS.txt
)
'''

        unstash 'windows-release-bundles'

        sh '''#!/usr/bin/env bash
set -euo pipefail

find src-tauri/target/release/bundle -type f '(' -name '*.exe' -o -name '*.msi' -o -name '*.zip' ')' -exec cp {} release-artifacts/ ';' 2>/dev/null || true
find src-tauri/target/release -maxdepth 1 -type f '(' -name '*.exe' -o -name '*.msi' -o -name '*.zip' ')' -exec cp {} release-artifacts/ ';' 2>/dev/null || true
find src-tauri/target/x86_64-pc-windows-msvc/release -maxdepth 1 -type f '(' -name '*.exe' -o -name '*.msi' -o -name '*.zip' ')' -exec cp {} release-artifacts/ ';' 2>/dev/null || true

(
  cd release-artifacts
  find . -type f ! -name 'SHA256SUMS.txt' -print0 \
    | sort -z \
    | xargs -0 sha256sum > SHA256SUMS.txt
)
'''
      }
    }

    stage('Build Summary') {
      steps {
        sh '''#!/usr/bin/env bash
set -euo pipefail

START_EPOCH=$(cat .build-start-epoch 2>/dev/null || echo "$(date +%s)")
END_EPOCH=$(date +%s)
ELAPSED=$((END_EPOCH - START_EPOCH))

{
  echo "Release Build Summary"
  echo "====================="
  echo "Job: ${JOB_NAME}"
  echo "Build: #${BUILD_NUMBER}"
  echo "Tag: ${TAG_NAME:-unknown}"
  echo "Commit: ${GIT_COMMIT:-unknown}"
  echo "DurationSeconds: ${ELAPSED}"
  echo
  echo "Artifacts:"
  find release-artifacts -type f -printf "- %P\\n"
} > release-summary.txt

cat release-summary.txt
'''
      }
    }
  }

  post {
    always {
      script {
        if (env.WORKSPACE?.trim()) {
          archiveArtifacts artifacts: 'release-artifacts/**,release-summary.txt', allowEmptyArchive: true, fingerprint: true
        } else {
          echo 'Skipping artifact archival: no workspace context available.'
        }
      }
    }
    failure {
      script {
        def message = "[${env.JOB_NAME} #${env.BUILD_NUMBER}] RELEASE FAILED for tag ${env.TAG_NAME ?: 'unknown'} @ ${env.GIT_COMMIT ?: 'unknown'}"
        echo message
      }
    }
  }
}
